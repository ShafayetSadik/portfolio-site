---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { journalPapers, conferencePapers, underReview, dataset, type Publication } from '../data/cv';
import { rich } from '../lib/rich';

const groups: { label: string; items: Publication[] }[] = [
  { label: 'Journal', items: journalPapers },
  { label: 'Conference', items: conferencePapers },
  { label: 'Under review', items: underReview },
];
---

<Section id="publications" index="04" title="Publications" intro="Machine learning and reinforcement learning for LTE handover optimization, built on real-world drive-test data.">
  <div class="space-y-12">
    {groups.map((g) => (
      <div>
        <p data-reveal class="label">{g.label}</p>
        <ol data-reveal-group class="mt-4 divide-y divide-line border-y border-line">
          {g.items.map((p) => (
            <li data-reveal-item class="grid gap-2 py-6 sm:grid-cols-[4.5rem_1fr] sm:gap-6">
              <p class="font-mono text-xs text-faint sm:pt-1">{p.year}</p>
              <div>
                <h3 class="text-[1.0625rem] font-medium leading-snug tracking-tight">
                  {p.doi ? (
                    <a
                      href={`https://doi.org/${p.doi}`}
                      target="_blank"
                      rel="noopener"
                      class="group/pub inline transition-colors hover:text-accent"
                    >
                      {p.title}
                      <Icon name="arrow-up-right" size={14} class="ml-0.5 inline -translate-y-px text-faint transition-colors group-hover/pub:text-accent" />
                    </a>
                  ) : (
                    p.title
                  )}
                </h3>
                <p class="mt-2 text-sm text-muted"><Fragment set:html={rich(p.authors)} /></p>
                <p class="mt-1 text-sm text-faint">
                  <em class="text-muted">{p.venue}</em>{p.details && <>, {p.details}</>}
                </p>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                  {p.doi && (
                    <span class="rounded-md bg-surface-2 px-2 py-0.5 font-mono text-[0.7rem] text-muted">doi:{p.doi}</span>
                  )}
                  {p.status && (
                    <span class="rounded-md bg-accent-soft px-2 py-0.5 font-mono text-[0.7rem] text-accent">{p.status}</span>
                  )}
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    ))}

    <div>
      <p data-reveal class="label">Dataset</p>
      <a
        data-reveal
        href={dataset.url}
        target="_blank"
        rel="noopener"
        class="card group mt-4 flex gap-5 p-6 transition-colors hover:border-faint"
      >
        <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-accent-soft text-accent">
          <Icon name="database" size={20} />
        </span>
        <div class="min-w-0">
          <h3 class="font-medium leading-snug tracking-tight transition-colors group-hover:text-accent">
            {dataset.title}
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{dataset.description}</p>
          <p class="mt-3 inline-flex items-center gap-1 font-mono text-xs text-faint">
            {dataset.host} <Icon name="arrow-up-right" size={12} />
          </p>
        </div>
      </a>
    </div>
  </div>
</Section>
