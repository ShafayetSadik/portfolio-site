---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { journalPapers, conferencePapers, underReview, dataset, profile, type Publication } from '../data/cv';
import { rich } from '../lib/rich';

// Optional paper figures: put files in src/assets/papers/ and set `image` in cv.ts.
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/papers/*.{jpg,jpeg,png,webp,avif}');
async function figure(p: Publication) {
  const key = p.image ? `../assets/papers/${p.image}` : null;
  return key && images[key] ? (await images[key]()).default : null;
}

const groups = await Promise.all(
  [
    { label: 'Journal', items: journalPapers },
    { label: 'Conference', items: conferencePapers },
    { label: 'Under review', items: underReview },
  ].map(async (g) => ({ ...g, items: await Promise.all(g.items.map(async (p) => ({ ...p, figure: await figure(p) }))) })),
);

const linksFor = (p: Publication) =>
  [
    p.doi && { label: 'DOI', href: `https://doi.org/${p.doi}` },
    p.pdf && { label: 'PDF', href: p.pdf },
    p.dataset && { label: 'Dataset', href: p.dataset },
    p.code && { label: 'Code', href: p.code },
  ].filter(Boolean) as { label: string; href: string }[];
---

<Section
  id="publications"
  title="Publications"
  link={profile.scholar ? { href: profile.scholar, label: 'Google Scholar' } : undefined}
>
  <div class="space-y-8">
    {groups.map((g) => (
      <div>
        <p data-reveal class="label">{g.label}</p>
        <ol data-reveal-group class="mt-3 space-y-5">
          {g.items.map((p) => (
            <li data-reveal-item class="grid grid-cols-[4.5rem_1fr] gap-4 md:grid-cols-[8.5rem_1fr] md:gap-6">
              <div class="thumb" aria-hidden={p.figure ? undefined : 'true'}>
                {p.figure ? (
                  <Image src={p.figure} alt="" widths={[144, 272]} sizes="(min-width: 768px) 8.5rem, 4.5rem" class="size-full object-cover" />
                ) : (
                  <span>{p.short}<br /><span class="text-faint">{p.year}</span></span>
                )}
              </div>
              <div class="min-w-0">
                <h3 class="font-semibold leading-snug">
                  {p.doi ? (
                    <a href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener" class="a-link">{p.title}</a>
                  ) : (
                    p.title
                  )}
                </h3>
                <p class="mt-1 text-[0.9375rem] leading-snug text-muted"><Fragment set:html={rich(p.authors)} /></p>
                <p class="mt-1 text-[0.9375rem] leading-snug text-muted">
                  <em>{p.venue}</em>{p.details && <>, {p.details}</>}{p.status ? '' : `, ${p.year}`}
                </p>
                <p class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
                  {p.status && (
                    <span class="rounded bg-accent-soft px-1.5 py-0.5 font-mono text-xs text-accent">{p.status}</span>
                  )}
                  {linksFor(p).map((l) => (
                    <a href={l.href} target="_blank" rel="noopener" class="a-link font-mono text-[0.8125rem]">[{l.label}]</a>
                  ))}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    ))}

    <div>
      <p data-reveal class="label">Dataset</p>
      <div data-reveal class="mt-3 grid grid-cols-[4.5rem_1fr] gap-4 md:grid-cols-[8.5rem_1fr] md:gap-6">
        <div class="thumb" aria-hidden="true"><span>DATA</span></div>
        <div class="min-w-0">
          <h3 class="font-semibold leading-snug">
            <a href={dataset.url} target="_blank" rel="noopener" class="a-link">{dataset.title}</a>
          </h3>
          <p class="mt-1 text-[0.9375rem] leading-relaxed text-muted">{dataset.description}</p>
          <p class="mt-1.5 text-sm">
            <a href={dataset.url} target="_blank" rel="noopener" class="a-link font-mono text-[0.8125rem]">[{dataset.host}]</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</Section>
