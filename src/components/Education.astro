---
import Section from './Section.astro';
import { education, ielts } from '../data/cv';

const bands = ielts.bands.map((b) => `${b.skill[0]} ${b.score.toFixed(1)}`).join(' · ');
---

<Section id="education" title="Education">
  <div data-reveal>
    <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
      <h3 class="font-semibold">{education.school}</h3>
      <p class="shrink-0 font-mono text-xs text-faint">{education.date}</p>
    </div>
    <p class="mt-1 text-[0.9375rem] text-muted">
      {education.degree} · CGPA <span class="font-semibold text-ink">{education.cgpa}</span>
    </p>
    <p class="mt-1 text-[0.9375rem] leading-snug text-muted">
      Thesis:{' '}<a href={education.thesis.url} target="_blank" rel="noopener" class="a-link italic">{education.thesis.title}</a>
    </p>
  </div>

  <p data-reveal class="mt-5 text-[0.9375rem] text-muted">
    <span class="font-semibold text-ink">English:</span>{' '}
    {ielts.test} ({ielts.body}), overall <span class="font-semibold text-ink">{ielts.overall.toFixed(1)}</span>{' '}
    <span class="whitespace-nowrap">({bands})</span>
  </p>
</Section>
