---
// Single-column academic section: heading with an optional link on the right.
interface Props {
  id: string;
  title: string;
  link?: { href: string; label: string };
}
const { id, title, link } = Astro.props;
---

<section id={id} class="container-page pt-12 md:pt-16" aria-labelledby={`${id}-title`}>
  <div data-reveal class="flex items-baseline justify-between gap-4 border-b border-line pb-2">
    <h2 id={`${id}-title`} class="text-xl font-semibold tracking-tight md:text-[1.375rem]">{title}</h2>
    {link && (
      <a href={link.href} target="_blank" rel="noopener" class="a-link shrink-0 text-sm">
        {link.label} <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
  <div class="mt-5 md:mt-6">
    <slot />
  </div>
</section>
