    | 'github'
    | 'linkedin'
    | 'mail'
    | 'phone'
    | 'download'
    | 'arrow-up-right'
    | 'sun'
    | 'moon'
    | 'menu'
    | 'close'
    | 'database'
    | 'file'
    | 'arrow-up';
