---
import Icon from './Icon.astro';
import { nav, profile } from '../data/cv';
import { asset } from '../lib/rich';
---

<header
  id="site-header"
  class="safe-x fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-300 data-[scrolled=true]:border-line data-[scrolled=true]:bg-bg/80 data-[scrolled=true]:backdrop-blur-md"
>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="#top" class="group flex h-11 items-center gap-2.5 text-[0.9375rem] font-semibold tracking-tight">
      <span aria-hidden="true" class="grid size-8 place-items-center rounded-lg bg-ink font-mono text-xs text-bg transition-colors group-hover:bg-accent group-hover:text-accent-ink">
        {profile.initials}
      </span>
      <span class="sr-only sm:not-sr-only">{profile.name}</span>
    </a>

    <nav aria-label="Sections" class="hidden lg:block">
      <ul id="nav-links" class="relative flex items-center gap-1 text-sm text-muted">
        <span
          id="nav-indicator"
          aria-hidden="true"
          class="pointer-events-none absolute left-0 top-0 h-full rounded-full bg-surface-2 opacity-0"
        ></span>
        {nav.map((item) => (
          <li class="relative">
            <a
              href={`#${item.id}`}
              data-nav-link={item.id}
              class="block rounded-full px-3 py-1.5 transition-colors hover:text-ink aria-[current=true]:text-ink"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button type="button" data-theme-toggle class="icon-btn size-11 lg:size-10" aria-label="Toggle color theme">
        <Icon name="sun" class="hidden dark:block" />
        <Icon name="moon" class="block dark:hidden" />
      </button>
      <button
        type="button"
        id="menu-button"
        class="icon-btn size-11 lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="menu-open-icon" />
        <Icon name="close" class="menu-close-icon hidden" />
      </button>
    </div>
  </div>

</header>

<!-- Full-screen sheet on phones/tablets; kept outside <header> because the header's
     backdrop-filter would otherwise trap this fixed element. Scroll lock in ui.ts. -->
  <div
    id="mobile-menu"
    class="safe-bottom safe-x fixed inset-x-0 bottom-0 top-16 z-40 hidden flex-col overflow-y-auto border-t border-line bg-bg lg:hidden"
  >
    <ul class="container-page flex flex-col pt-2">
      {nav.map((item, i) => (
        <li>
          <a
            href={`#${item.id}`}
            data-mobile-link
            class="flex items-baseline gap-4 border-b border-line py-4 text-[1.75rem] font-semibold tracking-tight active:text-accent"
          >
            <span class="label w-6">{String(i + 1).padStart(2, '0')}</span>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="container-page mt-auto grid grid-cols-2 gap-2 py-6">
      <a href={`mailto:${profile.email}`} class="btn btn-primary justify-center">
        <Icon name="mail" size={17} /> Email
      </a>
      <a href={asset(profile.cvFile)} class="btn btn-ghost justify-center" download>
        <Icon name="download" size={17} /> CV
      </a>
    </div>
  </div>

