---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import Icon from './Icon.astro';
import { projects, profile } from '../data/cv';

// Project images are optional: drop files into src/assets/projects/ and set `image` in cv.ts.
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.{jpg,jpeg,png,webp,avif}');
const resolved = await Promise.all(
  projects.map(async (p) => {
    const key = p.image ? `../assets/projects/${p.image}` : null;
    return key && images[key] ? (await images[key]()).default : null;
  }),
);
---

<Section id="projects" index="03" title="Projects" intro="Selected hardware and software builds, from rovers and drones to analog circuits.">
  <!-- Phones: horizontal swipe carousel (scroll-snap). sm and up: 2-column grid. -->
  <ul
    data-reveal-group
    data-carousel
    aria-label="Projects"
    class="no-scrollbar -mx-5 flex snap-x snap-mandatory scroll-px-5 gap-3 overflow-x-auto overscroll-x-contain px-5 pb-1 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-4 sm:overflow-visible sm:px-0 sm:pb-0"
  >
    {projects.map((p, i) => (
      <li data-reveal-item data-slide class="w-[85%] shrink-0 snap-start sm:w-auto">
        <a
          href={p.url}
          target="_blank"
          rel="noopener"
          class="card group flex h-full flex-col overflow-hidden transition-[border-color,transform] duration-300 hover:-translate-y-0.5 hover:border-faint"
        >
          {resolved[i] && (
            <div class="aspect-[16/10] overflow-hidden border-b border-line bg-surface-2">
              <Image
                src={resolved[i]!}
                alt={p.title}
                widths={[400, 640, 800]}
                sizes="(min-width: 640px) 50vw, 100vw"
                class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
          )}
          <div class="flex flex-1 flex-col p-5 sm:p-6">
            <div class="flex items-start justify-between gap-4">
              <span class="font-mono text-xs text-faint">{String(i + 1).padStart(2, '0')}</span>
              <Icon
                name="arrow-up-right"
                size={18}
                class="text-faint transition-[color,transform] duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent"
              />
            </div>
            <h3 class="mt-4 text-[1.0625rem] font-semibold tracking-tight">{p.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{p.description}</p>
            <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Tags">
              {p.tags.map((t) => (
                <li class="rounded-md bg-surface-2 px-2 py-0.5 font-mono text-[0.7rem] text-muted">{t}</li>
              ))}
            </ul>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <div data-carousel-controls class="mt-4 hidden items-center gap-4 sm:hidden">
    <p class="font-mono text-xs tabular-nums text-faint" aria-live="polite">
      <span data-carousel-current class="text-ink">01</span> / {String(projects.length).padStart(2, '0')}
    </p>
    <div class="h-px flex-1 overflow-hidden bg-line" aria-hidden="true">
      <div data-carousel-bar class="h-full origin-left bg-accent" style={`transform:scaleX(${1 / projects.length})`}></div>
    </div>
    <div class="flex gap-2">
      <button type="button" data-carousel-prev class="icon-btn" aria-label="Previous project">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      </button>
      <button type="button" data-carousel-next class="icon-btn" aria-label="Next project">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
      </button>
    </div>
  </div>

  <a
    data-reveal
    href={profile.github}
    target="_blank"
    rel="noopener"
    class="mt-6 inline-flex items-center gap-2 text-sm font-medium sm:mt-8 text-muted transition-colors hover:text-ink"
  >
    <Icon name="github" size={16} /> More on GitHub
    <Icon name="arrow-up-right" size={14} />
  </a>
</Section>
