---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { projects, profile } from '../data/cv';

// Project images are optional: drop files into src/assets/projects/ and set `image` in cv.ts.
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.{jpg,jpeg,png,webp,avif}');
const featured = await Promise.all(
  projects
    .filter((p) => p.featured)
    .map(async (p) => {
      const key = p.image ? `../assets/projects/${p.image}` : null;
      return { ...p, figure: key && images[key] ? (await images[key]()).default : null };
    }),
);
const others = projects.filter((p) => !p.featured);
---

<Section id="projects" title="Selected Projects" link={{ href: profile.github, label: 'GitHub' }}>
  <ol data-reveal-group class="space-y-5">
    {featured.map((p) => (
      <li
        data-reveal-item
        class:list={['grid gap-4 md:gap-6', p.figure && 'grid-cols-[4.5rem_1fr] md:grid-cols-[8.5rem_1fr]']}
      >
        {p.figure && (
          <div class="thumb !p-0">
            <Image src={p.figure} alt="" widths={[144, 272]} sizes="(min-width: 768px) 8.5rem, 4.5rem" class="size-full object-cover" />
          </div>
        )}
        <div class="min-w-0">
          <h3 class="font-semibold leading-snug">
            <a href={p.url} target="_blank" rel="noopener" class="a-link">{p.title}</a>
          </h3>
          <p class="mt-1 text-[0.9375rem] leading-relaxed text-muted">{p.description}</p>
          <p class="mt-1 font-mono text-xs text-faint">{p.tags.join(' · ')}</p>
        </div>
      </li>
    ))}
  </ol>

  <p data-reveal class="mt-6 text-[0.9375rem] leading-relaxed text-muted">
    <span class="font-semibold text-ink">Other projects:</span>{' '}
    {others.map((p, i) => (
      <>
        <a href={p.url} target="_blank" rel="noopener" class="a-link">{p.title}</a>{i < others.length - 1 ? ' · ' : '.'}
      </>
    ))}
  </p>
</Section>
