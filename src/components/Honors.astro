---
import Section from './Section.astro';
import { leadership, awards } from '../data/cv';
---

<Section id="honors" title="Honors & Leadership">
  <p data-reveal class="label">Competitions</p>
  <ul data-reveal-group class="mt-3 space-y-2.5 text-[0.9375rem] leading-snug">
    {awards.map((a) => (
      <li data-reveal-item>
        <span class="font-semibold">{a.result}</span>, {a.event}{' '}
        <span class="text-muted">({a.place}), with {a.team}</span>
      </li>
    ))}
  </ul>

  <p data-reveal class="label mt-7">Leadership</p>
  <ul data-reveal-group class="mt-3 space-y-2.5 text-[0.9375rem] leading-snug">
    {leadership.map((l) => (
      <li data-reveal-item class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
        <span>
          <span class="font-semibold">{l.role}</span>, {l.org}
          {l.note && <span class="text-muted"> ({l.note})</span>}
        </span>
        <span class="shrink-0 font-mono text-xs text-faint">{l.period}</span>
      </li>
    ))}
  </ul>
</Section>
