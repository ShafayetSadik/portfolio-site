---
import Section from './Section.astro';
import { skills } from '../data/cv';
---

<Section id="skills" title="Skills">
  <dl data-reveal-group class="space-y-2.5 text-[0.9375rem] leading-snug">
    {skills.map((s) => (
      <div data-reveal-item class="grid gap-x-6 gap-y-0.5 sm:grid-cols-[13rem_1fr]">
        <dt class="font-semibold">{s.group}</dt>
        <dd class="text-muted">{s.items.join(', ')}</dd>
      </div>
    ))}
  </dl>
</Section>
